# Copy to .env and adjust.

# SQLite (default, no Docker needed)
DATABASE_URL=sqlite:///./data/app.db
# Postgres + pgvector via docker compose:
# DATABASE_URL=postgresql+psycopg://upscaler:upscaler@localhost:5432/upscaler

UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=500

# Required to use /admin/* (tenant provisioning).
ADMIN_API_KEY=change-me

# Transcription: auto | openai | none. "auto" uses Whisper only when OPENAI_API_KEY is set.
TRANSCRIPTION_PROVIDER=auto
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_TRANSCRIPTION_MODEL=whisper-1
# Audio is extracted with ffmpeg (mono 16 kHz MP3) before sending to Whisper.
# Set an absolute path if ffmpeg isn't on PATH; empty disables extraction.
FFMPEG_PATH=ffmpeg
TRANSCRIPTION_AUDIO_BITRATE_KBPS=32

# Chunking
PDF_CHUNK_WORDS=300
PDF_CHUNK_OVERLAP=50
TRANSCRIPT_CHUNK_SECONDS=60

# xAPI ids are built under this IRI; use your deployed domain.
XAPI_BASE_IRI=https://ai-skill-upscaler.example/xapi
MAX_EVENTS_PER_BATCH=1000
